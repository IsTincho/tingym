{
  "name": "gymapp",
  "private": true,
  "workspaces": [
    "shared",
    "client",
    "server",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "test": "npm run test -w shared",
    "dev:api": "npm run dev -w worker",
    "deploy:api": "npm run deploy -w worker",
    "deploy:web": "npm run build && wrangler pages deploy client/dist --project-name tingym --branch main",
    "dev:server": "npm run dev -w server",
    "fetch:exercise-images": "node scripts/fetch-exercise-images.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
